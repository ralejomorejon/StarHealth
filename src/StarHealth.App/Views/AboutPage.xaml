<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StarHealth.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
        <StackPanel x:Name="Root"
            MaxWidth="1060"
            Padding="28,8,28,32"
            Spacing="18">

            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{x:Bind Vm.Tr('about.title'), Mode=OneWay}" />

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="StarHealth" />
                    <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('about.tagline'), Mode=OneWay}" TextWrapping="Wrap" />
                    <HyperlinkButton Content="github.com/ralejomorejon" NavigateUri="https://github.com/ralejomorejon" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('upd.title'), Mode=OneWay}" />
                    <TextBlock Foreground="White" Text="{x:Bind Vm.AppVersionText, Mode=OneWay}" />
                    <Button Command="{x:Bind Vm.CheckForUpdatesCommand}" Content="{x:Bind Vm.Tr('upd.check'), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.UpdateStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    <ProgressBar
                        Maximum="100"
                        Value="{x:Bind Vm.UpdateProgress, Mode=OneWay}"
                        Visibility="{x:Bind Vm.UpdateProgressVisibility, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind Vm.DownloadAndInstallCommand}"
                        Content="{x:Bind Vm.Tr('upd.install'), Mode=OneWay}"
                        Visibility="{x:Bind Vm.UpdateAvailableVisibility, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('about.how'), Mode=OneWay}" />
                    <TextBlock Foreground="White" Text="{x:Bind Vm.Tr('about.how.body'), Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('about.stack'), Mode=OneWay}" />
                    <TextBlock Foreground="White" Text="{x:Bind Vm.Tr('about.stack.body'), Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('about.note'), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('about.note.body'), Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

