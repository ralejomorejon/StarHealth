<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StarHealth.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource DishBackground}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Grid Background="{StaticResource DishBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera de escritorio: plan + modelo a la izquierda, estado a la derecha -->
        <Grid Padding="24,16,24,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="0">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{x:Bind Vm.HeaderTitle, Mode=OneWay}" />
                <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.HeaderSub, Mode=OneWay}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="10">
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource DishSubValue}"
                        Text="{x:Bind Vm.EndpointText}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource DishSubValue}"
                        Text="{x:Bind Vm.LastUpdatedText, Mode=OneWay}" />
                </StackPanel>
                <Border
                    Padding="10,4"
                    VerticalAlignment="Center"
                    Background="{x:Bind Vm.BadgeBrush, Mode=OneWay}"
                    CornerRadius="10">
                    <TextBlock
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="Black"
                        Text="{x:Bind Vm.BadgeText, Mode=OneWay}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="248"
            PaneDisplayMode="Left"
            SelectionChanged="OnSelectionChanged"
            Background="Transparent">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.status'), Mode=OneWay}" Tag="Estado" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.stats'), Mode=OneWay}" Tag="Estadisticas" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.network'), Mode=OneWay}" Tag="Red" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.account'), Mode=OneWay}" Tag="Suscripcion" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.obst'), Mode=OneWay}" Tag="Obstrucciones" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.align'), Mode=OneWay}" Tag="Alineacion" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.speed'), Mode=OneWay}" Tag="Velocidad" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.settings'), Mode=OneWay}" Tag="Configuracion" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.help'), Mode=OneWay}" Tag="Asistencia" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.about'), Mode=OneWay}" Tag="Acerca" />
            </NavigationView.MenuItems>
            <Frame
                x:Name="ContentFrame"
                Navigated="OnFrameNavigated"
                SizeChanged="OnFrameSizeChanged" />
        </NavigationView>
    </Grid>
</Page>
