<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StarHealth.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource DishBackground}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Grid Background="{StaticResource DishBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera de escritorio: plan + modelo a la izquierda; píldora de estado
             centrada sobre el área de contenido (no sobre la ventana completa). -->
        <Grid>
            <StackPanel Padding="24,16,24,12" Spacing="0">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{x:Bind Vm.HeaderTitle, Mode=OneWay}" />
                <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.HeaderSub, Mode=OneWay}" />
            </StackPanel>
            <!-- 248 = NavigationView.OpenPaneLength: el contenido vive a la derecha
                 del rail, así que la píldora se centra en esa región. -->
            <Grid Margin="248,16,0,12">
                <Border
                    Padding="22,12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF15171C"
                    BorderBrush="#FF2B2F38"
                    BorderThickness="1"
                    CornerRadius="25">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Grid
                            Width="26"
                            Height="26"
                            VerticalAlignment="Center">
                            <Ellipse
                                Width="26"
                                Height="26"
                                Fill="{x:Bind Vm.BadgeBrush, Mode=OneWay}"
                                Opacity="0.07" />
                            <Ellipse
                                Width="19"
                                Height="19"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{x:Bind Vm.BadgeBrush, Mode=OneWay}"
                                Opacity="0.14" />
                            <Ellipse
                                Width="13"
                                Height="13"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{x:Bind Vm.BadgeBrush, Mode=OneWay}"
                                Opacity="0.28" />
                            <Ellipse
                                Width="7"
                                Height="7"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{x:Bind Vm.BadgeBrush, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{x:Bind Vm.BadgeBrush, Mode=OneWay}"
                            Text="{x:Bind Vm.BadgeText, Mode=OneWay}" />
                        <Border
                            Width="1"
                            Height="16"
                            VerticalAlignment="Center"
                            Background="#FF363B46" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="#FFE8EAEE"
                            Text="StarHealth" />
                        <Border
                            Width="1"
                            Height="16"
                            VerticalAlignment="Center"
                            Background="#FF363B46" />
                        <TextBlock VerticalAlignment="Center" FontSize="14">
                            <Run Foreground="#FF8B909B" Text="{x:Bind Vm.Tr('misc.diship'), Mode=OneWay}" />
                            <Run Foreground="#FF8B909B" Text=": " />
                            <Run Foreground="#FFC9CDD6" Text="{x:Bind Vm.BadgeEndpointText, Mode=OneWay}" />
                        </TextBlock>
                        <Border
                            Width="1"
                            Height="16"
                            VerticalAlignment="Center"
                            Background="#FF363B46" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="#FF9BA1AC"
                            Text="{x:Bind Vm.LastUpdatedText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="248"
            PaneDisplayMode="Left"
            SelectionChanged="OnSelectionChanged"
            Background="Transparent">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.status'), Mode=OneWay}" Tag="Estado" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.stats'), Mode=OneWay}" Tag="Estadisticas" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.network'), Mode=OneWay}" Tag="Red" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.account'), Mode=OneWay}" Tag="Suscripcion" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.obst'), Mode=OneWay}" Tag="Obstrucciones" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.align'), Mode=OneWay}" Tag="Alineacion" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.speed'), Mode=OneWay}" Tag="Velocidad" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.settings'), Mode=OneWay}" Tag="Configuracion" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.help'), Mode=OneWay}" Tag="Asistencia" />
                <NavigationViewItem Content="{x:Bind Vm.Tr('nav.about'), Mode=OneWay}" Tag="Acerca" />
            </NavigationView.MenuItems>
            <Frame
                x:Name="ContentFrame"
                Navigated="OnFrameNavigated"
                SizeChanged="OnFrameSizeChanged" />
        </NavigationView>

        <!-- Dish-switch curtain: blocks all input until the first poll of the
             new dish lands (or a timeout releases it). -->
        <StackPanel
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="{x:Bind Vm.SwitchingVisibility, Mode=OneWay}"
            Background="#CC0B0D10">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <TextBlock
                    FontSize="28"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Text="···" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Text="{x:Bind Vm.Tr('dishes.switching'), Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
