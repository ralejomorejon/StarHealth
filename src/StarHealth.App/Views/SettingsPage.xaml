<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StarHealth.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
        <StackPanel x:Name="Root"
            MaxWidth="1060"
            Padding="28,8,28,32"
            Spacing="18">

            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{x:Bind Vm.Tr('cfg.title'), Mode=OneWay}" />

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('cfg.lang'), Mode=OneWay}" />
                    <ComboBox x:Name="LangBox" SelectionChanged="OnLangChanged">
                        <ComboBoxItem Content="Español" Tag="es" />
                        <ComboBoxItem Content="English" Tag="en" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('cfg.eq'), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('cfg.eq.snow'), Mode=OneWay}" />
                    <TextBlock Foreground="White" Text="{x:Bind Vm.ConfigSnowText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('cfg.eq.psave'), Mode=OneWay}" />
                    <TextBlock Foreground="White" Text="{x:Bind Vm.ConfigPowerSaveText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('cfg.eq.loc'), Mode=OneWay}" />
                    <TextBlock Foreground="White" Text="{x:Bind Vm.ConfigLocationText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('cfg.conn'), Mode=OneWay}" />
                    <TextBlock Foreground="White" Text="{x:Bind Vm.EndpointText}" />
                    <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('cfg.conn.note'), Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('cfg.src'), Mode=OneWay}" />
                    <TextBlock Style="{StaticResource DishSubValue}" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.src.intro'), Mode=OneWay}" />

                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource SourceTagDish}"><TextBlock Style="{StaticResource SourceTagText}" Text="{x:Bind Vm.Tr('src.dish'), Mode=OneWay}" /></Border>
                            <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.src.dish'), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource SourceTagRouter}"><TextBlock Style="{StaticResource SourceTagText}" Text="{x:Bind Vm.Tr('src.router'), Mode=OneWay}" /></Border>
                            <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.src.router'), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource SourceTagAccount}"><TextBlock Style="{StaticResource SourceTagText}" Text="{x:Bind Vm.Tr('src.acct'), Mode=OneWay}" /></Border>
                            <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.src.acct'), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource SourceTagDerived}"><TextBlock Style="{StaticResource SourceTagText}" Text="{x:Bind Vm.Tr('src.der'), Mode=OneWay}" /></Border>
                            <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.src.der'), Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('cfg.fw'), Mode=OneWay}" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.fw.1'), Mode=OneWay}" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.fw.2'), Mode=OneWay}" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.fw.3'), Mode=OneWay}" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.fw.4'), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('cfg.alt'), Mode=OneWay}" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.alt.1'), Mode=OneWay}" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.alt.2'), Mode=OneWay}" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.alt.3'), Mode=OneWay}" />
                    <TextBlock Foreground="White" TextWrapping="Wrap" Text="{x:Bind Vm.Tr('cfg.alt.4'), Mode=OneWay}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
