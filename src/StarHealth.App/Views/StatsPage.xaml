<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="StarHealth.App.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StarHealth.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
        <StackPanel x:Name="Root"
            MaxWidth="1060"
            Padding="28,8,28,32"
            Spacing="18">

            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{x:Bind Vm.Tr('stats.title'), Mode=OneWay}" />

            <Border Style="{StaticResource DishCardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('perf.title'), Mode=OneWay}" />
                        <Border Style="{StaticResource SourceTagDish}">
                            <TextBlock Style="{StaticResource SourceTagText}" Text="{x:Bind Vm.Tr('src.dish'), Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox SelectedIndex="{x:Bind Vm.HistoryRange, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Bind Vm.Tr('hist.range.live'), Mode=OneWay}" />
                            <ComboBoxItem Content="{x:Bind Vm.Tr('hist.range.24h'), Mode=OneWay}" />
                            <ComboBoxItem Content="{x:Bind Vm.Tr('hist.range.7d'), Mode=OneWay}" />
                        </ComboBox>
                        <Button Command="{x:Bind Vm.RefreshHistoryCommand}" Content="{x:Bind Vm.Tr('hist.refresh'), Mode=OneWay}" />
                    </StackPanel>
                    <controls:ThroughputChart
                        Height="220"
                        Max="{x:Bind Vm.ChartMax, Mode=OneWay}"
                        Samples="{x:Bind Vm.ChartSamples, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('perf.note'), Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource DishCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('usage.title'), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource DishBigValue}" Text="{x:Bind Vm.UsageText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('usage.sub'), Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource DishCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('power.title'), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource DishBigValue}" Text="{x:Bind Vm.PowerText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.PowerNote, Mode=OneWay}" TextWrapping="Wrap" />
                        <controls:Sparkline
                            Height="44"
                            Max="{x:Bind Vm.PowerMax, Mode=OneWay}"
                            Unit="W"
                            Values="{x:Bind Vm.PowerSeries, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource DishCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('device.title'), Mode=OneWay}" />
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('device.hw'), Mode=OneWay}" />
                                <TextBlock Foreground="White" Text="{x:Bind Vm.HardwareText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('device.sw'), Mode=OneWay}" />
                                <TextBlock Foreground="White" Text="{x:Bind Vm.SoftwareText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('device.update'), Mode=OneWay}" />
                                <TextBlock Foreground="White" Text="{x:Bind Vm.SoftwareUpdateText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('device.id'), Mode=OneWay}" />
                                <TextBlock Foreground="White" Text="{x:Bind Vm.DishIdText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('device.uptime'), Mode=OneWay}" />
                                <TextBlock Foreground="White" Text="{x:Bind Vm.UptimeText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('device.reboot'), Mode=OneWay}" />
                                <TextBlock Foreground="White" Text="{x:Bind Vm.RebootText, Mode=OneWay}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('device.batt'), Mode=OneWay}" Visibility="{x:Bind Vm.BatteryVisibility, Mode=OneWay}" />
                                <TextBlock Foreground="White" Text="{x:Bind Vm.BatteryText, Mode=OneWay}" Visibility="{x:Bind Vm.BatteryVisibility, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('device.loc'), Mode=OneWay}" />
                                <TextBlock Foreground="White" Text="{x:Bind Vm.LocationText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Style="{StaticResource DishCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('alerts.title'), Mode=OneWay}" />
                        <TextBlock
                            Style="{StaticResource DishSubValue}"
                            Text="{x:Bind Vm.Tr('alerts.none'), Mode=OneWay}"
                            Visibility="{x:Bind Vm.NoAlertsVisibility, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind Vm.Alerts, Mode=OneWay}"
                            Visibility="{x:Bind Vm.AlertsVisibility, Mode=OneWay}">
                            <ItemsControl.ItemTemplateSelector>
                                <controls:AlertTemplateSelector>
                                    <controls:AlertTemplateSelector.GoodTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Foreground="{StaticResource DishGood}"
                                                Text="{Binding Message}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </controls:AlertTemplateSelector.GoodTemplate>
                                    <controls:AlertTemplateSelector.WarnTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Foreground="{StaticResource DishWarn}"
                                                Text="{Binding Message}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </controls:AlertTemplateSelector.WarnTemplate>
                                </controls:AlertTemplateSelector>
                            </ItemsControl.ItemTemplateSelector>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource DishCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('events.title'), Mode=OneWay}" />
                        <TextBlock
                            FontSize="15"
                            Foreground="White"
                            Text="{x:Bind Vm.OutageSummary, Mode=OneWay}" />
                        <ToggleSwitch
                            Header="{x:Bind Vm.Tr('events.brief'), Mode=OneWay}"
                            IsOn="{x:Bind Vm.ShowBriefEvents, Mode=TwoWay}" />
                        <ItemsControl ItemsSource="{x:Bind Vm.Timeline, Mode=OneWay}">
                            <ItemsControl.ItemTemplateSelector>
                                <controls:TimelineTemplateSelector>
                                    <controls:TimelineTemplateSelector.OutageTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Padding="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Foreground="White"
                                                    Text="{Binding TimeText}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{StaticResource DishDim}"
                                                    Text="{Binding DurationText}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{StaticResource DishWarn}"
                                                    Text="{Binding Text}" />
                                            </Grid>
                                        </DataTemplate>
                                    </controls:TimelineTemplateSelector.OutageTemplate>
                                    <controls:TimelineTemplateSelector.EventTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Padding="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Foreground="White"
                                                    Text="{Binding TimeText}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Foreground="{StaticResource DishDim}"
                                                    Text="{Binding DurationText}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Foreground="{StaticResource DishDim}"
                                                    Text="{Binding Text}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </controls:TimelineTemplateSelector.EventTemplate>
                                </controls:TimelineTemplateSelector>
                            </ItemsControl.ItemTemplateSelector>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource DishCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('sla.title'), Mode=OneWay}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource DishSubValue}"
                                    Text="{x:Bind Vm.Tr('sla.24h'), Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{x:Bind Vm.Sla24Text, Mode=OneWay}" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="1"
                                Margin="0,4"
                                VerticalAlignment="Stretch"
                                Background="#232A33" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource DishSubValue}"
                                    Text="{x:Bind Vm.Tr('sla.7d'), Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{x:Bind Vm.Sla7Text, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.Tr('perf.note'), Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="3"
                    Grid.Column="2"
                    Style="{StaticResource DishCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource DishCardTitle}" Text="{x:Bind Vm.Tr('rpt.title'), Mode=OneWay}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind Vm.CopyReportCommand}"
                            Content="{x:Bind Vm.Tr('rpt.copy'), Mode=OneWay}" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind Vm.SaveReportCommand}"
                            Content="{x:Bind Vm.Tr('rpt.save'), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource DishSubValue}" Text="{x:Bind Vm.ReportStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
